{
  "name": "platemate-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "PlateMate Food Delivery — Monorepo Root",
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "dev": "npm run dev --prefix backend & npm run dev --prefix frontend",
    "frontend": "npm run dev --prefix frontend",
    "backend": "npm run dev --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build:backend": "npm run db:generate --prefix backend",
    "build": "npm run build:frontend && npm run build:backend",
    "clean": "rimraf frontend/dist backend/coverage frontend/coverage",
    "db:generate": "npm run db:generate --prefix backend",
    "db:migrate:prod": "npm run db:migrate:prod --prefix backend",
    "db:seed": "npm run db:seed --prefix backend",
    "lint": "npm run lint --prefix frontend",
    "test": "npm run test --prefix frontend && npm run test:unit --prefix backend"
  },
  "keywords": [
    "platemate",
    "food-delivery",
    "monorepo",
    "express",
    "react",
    "prisma"
  ],
  "author": "PlateMate",
  "license": "MIT"
}
