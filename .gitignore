# ─────────────────────────────────────────────────────────────────────────────
# PlateMate — Monorepo .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
**/node_modules/
.pnp
.pnp.js

# ── Environment Variables (NEVER commit secrets) ──────────────────────────────
.env
.env.*
!.env.example
!.env.*.example

# ── Build & Static Outputs ─────────────────────────────────────────────────────
dist/
**/dist/
frontend/dist/
frontend/.vite/
.vite/

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/
**/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Prisma ────────────────────────────────────────────────────────────────────
# Note: prisma/schema.prisma and migrations ARE committed.
# Generated client in node_modules is ignored via **/node_modules/

# ── OS & System Files ─────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ── IDE & Editor Settings ─────────────────────────────────────────────────────
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ── Testing & Coverage ────────────────────────────────────────────────────────
coverage/
**/coverage/
.nyc_output/
playwright-report/
test-results/

# ── Uploads & Temp Storage ───────────────────────────────────────────────────
uploads/
**/uploads/
temp/
**/temp/
.docker/
postgres-data/
redis-data/
