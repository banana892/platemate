# ─────────────────────────────────────────────────────────────────────────────
# PlateMate Backend — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database (PostgreSQL) ──────────────────────────────────────────────────────
# Local development:
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/platemate?schema=public"
# Neon (production — add ?pgbouncer=true&connect_timeout=10):
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.neon.tech/platemate?sslmode=require"

# ── JWT Secrets ────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Redis ──────────────────────────────────────────────────────────────────────
# Local: redis://localhost:6379
# Upstash (production): rediss://default:TOKEN@host.upstash.io:PORT
REDIS_URL=redis://localhost:6379

# ── Cloudinary ─────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Resend (Email) ─────────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_api_key
FROM_EMAIL=noreply@platemate.com
FROM_NAME=PlateMate

# ── Razorpay (Phase 10) ────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── App ────────────────────────────────────────────────────────────────────────
APP_NAME=PlateMate
API_VERSION=v1

# ── Bcrypt ─────────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── Email Verification ─────────────────────────────────────────────────────────
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFY_EXPIRES=24h
PASSWORD_RESET_EXPIRES=1h

# ── Google OAuth (Phase 4 extension) ──────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback
