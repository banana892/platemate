{
  "name": "platemate-backend",
  "version": "1.0.0",
  "description": "PlateMate Food Delivery — Backend API",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon --config nodemon.json src/server.js",
    "start": "node src/server.js",
    "start:prod": "prisma migrate deploy && node src/server.js",
    "build": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "test:customer": "node src/tests/customerApis.test.js",
    "test:partner": "node src/tests/partnerApis.test.js",
    "test:rider": "node src/tests/riderApis.test.js",
    "test:admin": "node src/tests/adminApis.test.js",
    "test:socket": "node src/tests/socket.test.js",
    "test:payment": "NODE_ENV=test node src/tests/paymentApis.test.js",
    "test:redis": "NODE_ENV=test node src/tests/redis.test.js",
    "test:media": "NODE_ENV=test node src/tests/media.test.js",
    "test:security": "NODE_ENV=test node src/tests/security.test.js",
    "test:jest": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest src/__tests__/unit",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest src/__tests__/integration --forceExit",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "food-delivery",
    "api",
    "express",
    "prisma",
    "postgresql"
  ],
  "author": "PlateMate",
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "^7.8.0",
    "razorpay": "^2.9.8",
    "resend": "^6.17.2",
    "socket.io": "^4.8.3",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@types/node": "^26.1.1",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2"
  }
}
