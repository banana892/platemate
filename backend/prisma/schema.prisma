// ─────────────────────────────────────────────────────────────────────────────
// PlateMate — Prisma Schema (Phase 3)
//
// This is the SINGLE SOURCE OF TRUTH for the database.
// All 20 models, 8 enums, relationships, indexes, and constraints are defined here.
//
// Prisma v7: DATABASE_URL is configured in prisma.config.ts, not here.
//
// CONVENTIONS:
// - Models:      PascalCase singular (User, Restaurant, MenuItem)
// - Fields:      camelCase (firstName, createdAt, isActive)
// - Enums:       PascalCase name, SCREAMING_SNAKE values (Role.CUSTOMER)
// - Table maps:  snake_case plural (@@map("users"), @@map("restaurants"))
// - Column maps: snake_case (createdAt → @map("created_at"))
// - Indexes:     Named descriptively for PostgreSQL visibility
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

/// User roles — mirrors src/constants/roles.js
enum Role {
  CUSTOMER
  PARTNER
  RIDER
  ADMIN
}

/// Address types for saved delivery addresses
enum AddressType {
  HOME
  WORK
  HOTEL
  OTHER
}

/// Order lifecycle states
enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

/// Payment processing states
enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

/// Payment methods available to customers
enum PaymentMethod {
  UPI
  CARD
  NET_BANKING
  WALLET
  COD
}

/// Payment gateway providers
enum PaymentProvider {
  RAZORPAY
  STRIPE
  COD
}

/// Notification categories
enum NotificationType {
  ORDER
  PROMO
  SYSTEM
}

/// Days of the week for business hours
enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

/// Rider availability status
enum RiderStatus {
  ONLINE
  OFFLINE
  BUSY
  ON_BREAK
}

/// Token types for verification and password reset flows
enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

// ─────────────────────────────────────────────────────────────────────────────
// IDENTITY DOMAIN
// ─────────────────────────────────────────────────────────────────────────────

/// Central identity model for all four roles (CUSTOMER, PARTNER, RIDER, ADMIN).
/// Role-specific data lives in extension tables (RestaurantOwner, DeliveryPartner).
model User {
  id         String    @id @default(uuid())
  name       String
  email      String    @unique
  phone      String?   @unique
  password   String
  avatar     String?
  imageUrl   String?   @map("image_url")
  publicId   String?   @map("public_id")
  role       Role      @default(CUSTOMER)
  isVerified Boolean   @default(false) @map("is_verified")
  isActive     Boolean   @default(true) @map("is_active")
  tokenVersion Int       @default(0) @map("token_version")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  // ── Relationships ──────────────────────────────────────────────────────
  addresses          Address[]
  refreshTokens      RefreshToken[]
  verificationTokens VerificationToken[]
  restaurantOwner    RestaurantOwner?
  deliveryPartner    DeliveryPartner?
  cart               Cart?
  orders             Order[]
  reviews            Review[]
  favorites          Favorite[]
  notifications      Notification[]
  payments           Payment[]
  passwordHistory    PasswordHistory[]

  // ── Indexes ────────────────────────────────────────────────────────────
  @@index([role, isActive, deletedAt], name: "idx_user_role_active")
  @@map("users")
}

/// Saved delivery addresses for users.
/// One user can have multiple addresses (Home, Work, Hotel, etc.).
model Address {
  id               String      @id @default(uuid())
  userId           String      @map("user_id")
  label            String
  type             AddressType @default(HOME)
  recipientName    String?     @map("recipient_name")
  phone            String?
  houseNumber      String?     @map("house_number")
  formattedAddress String?     @map("formatted_address")
  street           String?
  landmark         String?
  city             String
  state            String
  country          String      @default("India")
  postalCode       String      @map("postal_code")
  latitude         Decimal     @db.Decimal(10, 7)
  longitude        Decimal     @db.Decimal(10, 7)
  isDefault        Boolean     @default(false) @map("is_default")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  // ── Relationships ──────────────────────────────────────────────────────
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ── Indexes ────────────────────────────────────────────────────────────
  @@index([userId, isDefault], name: "idx_address_user_default")
  @@map("addresses")
}

/// Hashed refresh tokens for JWT rotation and multi-device sessions.
/// Supports revocation, device tracking, and automatic cleanup.
model RefreshToken {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  hashedToken String    @map("hashed_token")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  deviceInfo  String?   @map("device_info")
  ipAddress   String?   @map("ip_address")
  createdAt   DateTime  @default(now()) @map("created_at")

  // ── Relationships ──────────────────────────────────────────────────────
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ── Indexes ────────────────────────────────────────────────────────────
  @@index([userId], name: "idx_refresh_token_user")
  @@index([hashedToken], name: "idx_refresh_token_hash")
  @@index([expiresAt], name: "idx_refresh_token_expiry")
  @@map("refresh_tokens")
}

/// Tokens for email verification and password reset.
/// Hashed for security, single-use (tracked via usedAt).
model VerificationToken {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  hashedToken String    @map("hashed_token")
  type        TokenType
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  // ── Relationships ──────────────────────────────────────────────────────
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ── Indexes ────────────────────────────────────────────────────────────
  @@index([hashedToken, type], name: "idx_verification_token_hash")
  @@index([userId, type], name: "idx_verification_token_user")
  @@map("verification_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// RESTAURANT DOMAIN
// ─────────────────────────────────────────────────────────────────────────────

/// Extension of User for the PARTNER role.
/// Stores business registration, banking, and approval status.
/// A partner can own multiple restaurants.
model RestaurantOwner {
  id               String   @id @default(uuid())
  userId           String   @unique @map("user_id")
  businessName     String?  @map("business_name")
  panNumber        String?  @map("pan_number")
  gstNumber        String?  @map("gst_number")
  bankAccountNumber String? @map("bank_account_number")
  ifscCode         String?  @map("ifsc_code")
  isApproved       Boolean  @default(false) @map("is_approved")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // ── Relationships ──────────────────────────────────────────────────────
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurants Restaurant[]

  @@map("restaurant_owners")
}

/// The core business entity. Each restaurant has its own address, categories,
/// menu items, business hours, and cuisines. Supports multi-city from day one.
model Restaurant {
  id                  String    @id @default(uuid())
  ownerId             String    @map("owner_id")
  name                String
  slug                String    @unique
  description         String?
  image               String?
  imageUrl            String?   @map("image_url")
  publicId            String?   @map("public_id")
  bannerUrl           String?   @map("banner_url")
  bannerPublicId      String?   @map("banner_public_id")
  phone               String
  email               String?
  street              String
  landmark            String?
  city                String
  state               String
  country             String    @default("India")
  postalCode          String    @map("postal_code")
  latitude            Decimal   @db.Decimal(10, 7)
  longitude           Decimal   @db.Decimal(10, 7)
  deliveryRadius      Decimal   @default(5.0) @map("delivery_radius") @db.Decimal(5, 2)
  minimumOrder        Decimal   @default(0) @map("minimum_order") @db.Decimal(10, 2)
  deliveryFee         Decimal   @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  averageDeliveryTime Int       @default(30) @map("average_delivery_time")
  averageRating       Decimal   @default(0) @map("average_rating") @db.Decimal(3, 2)
  totalReviews        Int       @default(0) @map("total_reviews")
  isActive            Boolean   @default(true) @map("is_active")
  isFeatured          Boolean   @default(false) @map("is_featured")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  // ── Relationships ──────────────────────────────────────────────────────
  owner         RestaurantOwner     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  cuisines      RestaurantCuisine[]
  categories    Category[]
  menuItems     MenuItem[]
  businessHours BusinessHour[]
  orders        Order[]
  reviews       Review[]
  favorites     Favorite[]
  carts         Cart[]
  settings      RestaurantSettings?

  // ── Indexes ────────────────────────────────────────────────────────────
  @@index([ownerId], name: "idx_restaurant_owner")
  @@index([city], name: "idx_restaurant_city")
  @@index([city, isActive, deletedAt], name: "idx_restaurant_city_active")
  @@index([isFeatured], name: "idx_restaurant_featured")
  @@map("restaurants")
}

/// Cuisine lookup table (admin-managed).
/// Linked to restaurants via the RestaurantCuisine junction table.
model Cuisine {
  id        String   @id @default(uuid())
  name      String   @unique
  image     String?
  imageUrl  String?   @map("image_url")
  publicId  String?   @map("public_id")
  createdAt DateTime @default(now()) @map("created_at")

  // ── Relationships ──────────────────────────────────────────────────────
  restaurants RestaurantCuisine[]

  @@map("cuisines")
}

/// Junction table resolving the many-to-many between Restaurant and Cuisine.
model RestaurantCuisine {
  id           String @id @default(uuid())
  restaurantId String @map("restaurant_id")
  cuisineId    String @map("cuisine_id")

  // ── Relationships ──────────────────────────────────────────────────────
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  cuisine    Cuisine    @relation(fields: [cuisineId], references: [id], onDelete: Cascade)

  // ── Constraints ────────────────────────────────────────────────────────
  @@unique([restaurantId, cuisineId], name: "uq_restaurant_cuisine")
  @@map("restaurant_cuisines")
}

/// Restaurant-scoped menu categories (e.g., "Starters", "Main Course", "Beverages").
/// Each restaurant defines its own categories. Menu items belong to one category.
model Category {
  id           String   @id @default(uuid())
  restaurantId String   @map("restaurant_id")
  name         String
  description  String?
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // ── Relationships ──────────────────────────────────────────────────────
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItems  MenuItem[]

  // ── Constraints ────────────────────────────────────────────────────────
  @@unique([restaurantId, name], name: "uq_category_restaurant_name")
  @@map("categories")
}

/// Individual menu items (dishes). Each belongs to one restaurant and one category.
/// Soft-deleted to preserve order history references.
model MenuItem {
  id           String    @id @default(uuid())
  restaurantId String    @map("restaurant_id")
  categoryId   String    @map("category_id")
  name         String
  slug         String    @unique
  description  String?
  price        Decimal   @db.Decimal(10, 2)
  image        String?
  imageUrl     String?   @map("image_url")
  publicId     String?   @map("public_id")
  isVeg        Boolean   @default(true) @map("is_veg")
  isAvailable  Boolean   @default(true) @map("is_available")
  isFeatured   Boolean   @default(false) @map("is_featured")
  sortOrder    Int       @default(0) @map("sort_order")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  // ── Relationships ──────────────────────────────────────────────────────
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category   Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  cartItems  CartItem[]
  orderItems OrderItem[]

  // ── Indexes ────────────────────────────────────────────────────────────
  @@index([restaurantId, isAvailable, deletedAt], name: "idx_menu_item_active")
  @@index([categoryId], name: "idx_menu_item_category")
  @@map("menu_items")
}

/// Business hours — one record per day per restaurant (7 records total).
/// openTime and closeTime use "HH:mm" 24-hour format strings.
model BusinessHour {
  id           String    @id @default(uuid())
  restaurantId String    @map("restaurant_id")
  dayOfWeek    DayOfWeek @map("day_of_week")
  openTime     String    @map("open_time")
  closeTime    String    @map("close_time")
  isClosed     Boolean   @default(false) @map("is_closed")

  // ── Relationships ──────────────────────────────────────────────────────
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  // ── Constraints ────────────────────────────────────────────────────────
  @@unique([restaurantId, dayOfWeek], name: "uq_business_hour_day")
  @@map("business_hours")
}

// ─────────────────────────────────────────────────────────────────────────────
// COMMERCE DOMAIN
// ─────────────────────────────────────────────────────────────────────────────

/// One active cart per user. The restaurantId enforces the single-restaurant rule:
/// all items must come from the same restaurant (Swiggy/Zomato UX pattern).
model Cart {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  restaurantId String   @map("restaurant_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // ── Relationships ──────────────────────────────────────────────────────
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      CartItem[]

  @@map("carts")
}

/// Individual items within a cart. References a MenuItem with quantity.
model CartItem {
  id         String   @id @default(uuid())
  cartId     String   @map("cart_id")
  menuItemId String   @map("menu_item_id")
  quantity   Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // ── Relationships ──────────────────────────────────────────────────────
  cart     Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  // ── Constraints ────────────────────────────────────────────────────────
  @@unique([cartId, menuItemId], name: "uq_cart_item")
  @@map("cart_items")
}

/// A completed purchase. Snapshots cart at checkout time.
/// Contains delivery address snapshot, pricing breakdown, and lifecycle status.
model Order {
  id                    String      @id @default(uuid())
  orderNumber           String      @unique @map("order_number")
  userId                String      @map("user_id")
  restaurantId          String      @map("restaurant_id")
  deliveryPartnerId     String?     @map("delivery_partner_id")
  couponId              String?     @map("coupon_id")
  status                OrderStatus @default(PENDING)
  subtotal              Decimal     @db.Decimal(10, 2)
  deliveryFee           Decimal     @map("delivery_fee") @db.Decimal(10, 2)
  discount              Decimal     @default(0) @db.Decimal(10, 2)
  tax                   Decimal     @default(0) @db.Decimal(10, 2)
  totalAmount           Decimal     @map("total_amount") @db.Decimal(10, 2)
  deliveryAddress       String      @map("delivery_address")
  deliveryLatitude      Decimal?    @map("delivery_latitude") @db.Decimal(10, 7)
  deliveryLongitude     Decimal?    @map("delivery_longitude") @db.Decimal(10, 7)
  notes                 String?
  estimatedDeliveryTime DateTime?   @map("estimated_delivery_time")
  deliveredAt           DateTime?   @map("delivered_at")
  cancelledAt           DateTime?   @map("cancelled_at")
  cancellationReason    String?     @map("cancellation_reason")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  // ── Relationships ──────────────────────────────────────────────────────
  user            User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  restaurant      Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  deliveryPartner DeliveryPartner? @relation(fields: [deliveryPartnerId], references: [id], onDelete: SetNull)
  coupon          Coupon?          @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  payment         Payment?
  review          Review?

  // ── Indexes ────────────────────────────────────────────────────────────
  @@index([userId, status], name: "idx_order_user_status")
  @@index([restaurantId], name: "idx_order_restaurant")
  @@index([deliveryPartnerId], name: "idx_order_delivery_partner")
  @@index([status], name: "idx_order_status")
  @@map("orders")
}

/// Line items within an order. Snapshots menu item name and price at order time
/// to preserve financial accuracy even if the original item changes.
model OrderItem {
  id         String  @id @default(uuid())
  orderId    String  @map("order_id")
  menuItemId String  @map("menu_item_id")
  name       String
  quantity   Int
  unitPrice  Decimal @map("unit_price") @db.Decimal(10, 2)
  totalPrice Decimal @map("total_price") @db.Decimal(10, 2)
  createdAt  DateTime @default(now()) @map("created_at")

  // ── Relationships ──────────────────────────────────────────────────────
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  // ── Indexes ────────────────────────────────────────────────────────────
  @@index([orderId], name: "idx_order_item_order")
  @@map("order_items")
}

/// One payment per order. Supports multiple payment providers (Razorpay, Stripe, COD)
/// and methods (UPI, Card, Net Banking, Wallet, COD).
model Payment {
  id                 String          @id @default(uuid())
  orderId            String          @unique @map("order_id")
  userId             String?         @map("user_id")
  provider           PaymentProvider
  providerPaymentId  String?         @unique @map("provider_payment_id")
  providerOrderId    String?         @unique @map("provider_order_id")
  providerSignature  String?         @map("provider_signature")
  amount             Decimal         @db.Decimal(10, 2)
  currency           String          @default("INR")
  status             PaymentStatus   @default(PENDING)
  method             PaymentMethod
  failureReason      String?         @map("failure_reason")
  refundAmount       Decimal         @default(0.00) @map("refund_amount") @db.Decimal(10, 2)
  refundedAt         DateTime?       @map("refunded_at")
  metadata           Json?           @map("metadata")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  // ── Relationships ──────────────────────────────────────────────────────
  order              Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user               User?           @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ── Indexes ────────────────────────────────────────────────────────────
  @@index([status], name: "idx_payment_status")
  @@index([userId], name: "idx_payment_user")
  @@map("payments")
}

/// Discount coupons — platform-wide (global scope).
/// Supports percentage and flat discounts with usage limits and validity periods.
model Coupon {
  id              String    @id @default(uuid())
  code            String    @unique
  description     String?
  discountPercent Decimal?  @map("discount_percent") @db.Decimal(5, 2)
  discountAmount  Decimal?  @map("discount_amount") @db.Decimal(10, 2)
  maxDiscount     Decimal?  @map("max_discount") @db.Decimal(10, 2)
  minimumOrder    Decimal   @default(0) @map("minimum_order") @db.Decimal(10, 2)
  usageLimit      Int?      @map("usage_limit")
  usedCount       Int       @default(0) @map("used_count")
  validFrom       DateTime  @map("valid_from")
  validUntil      DateTime  @map("valid_until")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // ── Relationships ──────────────────────────────────────────────────────
  orders Order[]

  // ── Indexes ────────────────────────────────────────────────────────────
  @@index([isActive, validFrom, validUntil], name: "idx_coupon_valid")
  @@map("coupons")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENGAGEMENT DOMAIN
// ─────────────────────────────────────────────────────────────────────────────

/// Customer reviews of restaurants. One review per user per restaurant,
/// tied to a specific completed order. Updates Restaurant.averageRating.
model Review {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  restaurantId String   @map("restaurant_id")
  orderId      String   @unique @map("order_id")
  rating       Int
  comment      String?
  isHidden     Boolean  @default(false) @map("is_hidden")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // ── Relationships ──────────────────────────────────────────────────────
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // ── Constraints ────────────────────────────────────────────────────────
  @@unique([userId, restaurantId], name: "uq_review_user_restaurant")
  @@index([restaurantId], name: "idx_review_restaurant")
  @@map("reviews")
}

/// User's favorited/saved restaurants.
model Favorite {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  restaurantId String   @map("restaurant_id")
  createdAt    DateTime @default(now()) @map("created_at")

  // ── Relationships ──────────────────────────────────────────────────────
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  // ── Constraints ────────────────────────────────────────────────────────
  @@unique([userId, restaurantId], name: "uq_favorite_user_restaurant")
  @@map("favorites")
}

/// In-app notifications for order updates, promotions, and system alerts.
model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false) @map("is_read")
  data      String?
  createdAt DateTime         @default(now()) @map("created_at")

  // ── Relationships ──────────────────────────────────────────────────────
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ── Indexes ────────────────────────────────────────────────────────────
  @@index([userId, isRead], name: "idx_notification_user_read")
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// OPERATIONS DOMAIN
// ─────────────────────────────────────────────────────────────────────────────

/// Extension of User for the RIDER role.
/// Stores vehicle info, live location, availability, and performance metrics.
model DeliveryPartner {
  id               String   @id @default(uuid())
  userId           String   @unique @map("user_id")
  vehicleType      String?  @map("vehicle_type")
  vehicleNumber    String?  @map("vehicle_number")
  licenseNumber    String?  @map("license_number")
  isAvailable      Boolean  @default(false) @map("is_available")
  isApproved       Boolean  @default(false) @map("is_approved")
  currentLatitude  Decimal? @map("current_latitude") @db.Decimal(10, 7)
  currentLongitude Decimal? @map("current_longitude") @db.Decimal(10, 7)
  totalDeliveries  Int      @default(0) @map("total_deliveries")
  averageRating    Decimal  @default(0) @map("average_rating") @db.Decimal(3, 2)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // ── Relationships ──────────────────────────────────────────────────────
  user     User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders   Order[]
  settings DeliveryPartnerSettings?

  // ── Indexes ────────────────────────────────────────────────────────────
  @@index([isAvailable, isApproved], name: "idx_delivery_partner_available")
  @@map("delivery_partners")
}

/// Operational settings for a restaurant (Phase 6).
/// Prevents overloading the main Restaurant model with granular settings.
model RestaurantSettings {
  id                        String     @id @default(uuid())
  restaurantId              String     @unique @map("restaurant_id")
  autoAcceptOrders          Boolean    @default(false) @map("auto_accept_orders")
  acceptCashOnDelivery      Boolean    @default(true) @map("accept_cash_on_delivery")
  acceptScheduledOrders     Boolean    @default(false) @map("accept_scheduled_orders")
  preparationBufferTime     Int        @default(5) @map("preparation_buffer_time")
  estimatedPreparationTime Int        @default(20) @map("estimated_preparation_time")
  maxConcurrentOrders       Int        @default(10) @map("max_concurrent_orders")
  defaultPackagingCharge    Decimal    @default(0.00) @map("default_packaging_charge") @db.Decimal(10, 2)
  restaurantAnnouncement    String?    @map("restaurant_announcement")
  isTemporarilyClosed       Boolean    @default(false) @map("is_temporarily_closed")
  temporaryClosureReason    String?    @map("temporary_closure_reason")
  autoPauseWhenBusy         Boolean    @default(false) @map("auto_pause_when_busy")
  createdAt                 DateTime   @default(now()) @map("created_at")
  updatedAt                 DateTime   @updatedAt @map("updated_at")

  // Relationships
  restaurant                Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("restaurant_settings")
}

// ─────────────────────────────────────────────────────────────────────────────
// RIDER OPERATIONS DOMAIN (Phase 7)
// ─────────────────────────────────────────────────────────────────────────────

/// Operational settings for a delivery partner (Phase 7).
/// Stores live availability status, emergency contact, and per-delivery earnings rate.
/// Modeled after RestaurantSettings — lazy-initialized on first access.
model DeliveryPartnerSettings {
  id                  String       @id @default(uuid())
  deliveryPartnerId   String       @unique @map("delivery_partner_id")
  riderStatus         RiderStatus  @default(OFFLINE) @map("rider_status")
  emergencyContact    String?      @map("emergency_contact")
  earningsPerDelivery Decimal      @default(0) @map("earnings_per_delivery") @db.Decimal(10, 2)
  bonusEarnings       Decimal      @default(0) @map("bonus_earnings") @db.Decimal(10, 2)
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  // ── Relationships ──────────────────────────────────────────────────────
  deliveryPartner     DeliveryPartner @relation(fields: [deliveryPartnerId], references: [id], onDelete: Cascade)

  // ── Indexes ────────────────────────────────────────────────────────────
  @@index([riderStatus], name: "idx_rider_settings_status")
  @@map("delivery_partner_settings")
}

/// Global platform settings configuration (Phase 8).
/// Created as a single-row config table.
model PlatformSettings {
  id                 String   @id @default(uuid())
  platformName       String   @default("PlateMate") @map("platform_name")
  platformFeePercent Decimal  @default(5.00) @map("platform_fee_percent") @db.Decimal(5, 2)
  defaultDeliveryFee Decimal  @default(30.00) @map("default_delivery_fee") @db.Decimal(10, 2)
  supportEmail       String   @default("support@platemate.com") @map("support_email")
  supportPhone       String   @default("+919876543210") @map("support_phone")
  maintenanceMode    Boolean  @default(false) @map("maintenance_mode")
  termsUrl           String?  @map("terms_url")
  privacyUrl         String?  @map("privacy_url")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

/// Admin promotional banners (Phase 12).
model PromoBanner {
  id        String   @id @default(uuid())
  title     String?
  imageUrl  String   @map("image_url")
  publicId  String   @map("public_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("promo_banners")
}

// ─────────────────────────────────────────────────────────────────────────────
// SECURITY DOMAIN (Phase 13)
// ─────────────────────────────────────────────────────────────────────────────

/// Severity levels for audit log entries — INFO is routine, CRITICAL demands review.
enum AuditSeverity {
  INFO
  WARNING
  CRITICAL
}

/// Security-relevant actions recorded in the audit trail.
enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  PASSWORD_CHANGED
  ACCOUNT_LOCKED
  TOKEN_REVOKED
  ADMIN_ACTION
  SUSPICIOUS_ACTIVITY
  RATE_LIMIT_EXCEEDED
  UPLOAD_REJECTED
  PERMISSION_DENIED
}

/// Immutable audit trail for all security-sensitive events.
/// Written fire-and-forget from audit.service.js — never blocks request lifecycle.
/// Indexed for efficient admin queries by user, action, severity, and time.
model AuditLog {
  id        String        @id @default(uuid())
  requestId String?       @map("request_id")
  userId    String?       @map("user_id")
  action    AuditAction
  severity  AuditSeverity @default(INFO)
  ip        String?
  userAgent String?       @map("user_agent")
  meta      Json?
  createdAt DateTime      @default(now()) @map("created_at")

  // ── Indexes ────────────────────────────────────────────────────────────
  @@index([userId, createdAt], name: "idx_audit_user_time")
  @@index([action, createdAt], name: "idx_audit_action_time")
  @@index([severity, createdAt], name: "idx_audit_severity_time")
  @@map("audit_logs")
}

/// Stores bcrypt-hashed previous passwords to enforce password history policy.
/// Compared using bcrypt.compare() in password.service.js — raw passwords are never stored.
/// Pruned to the last N entries defined in SECURITY_CONFIG.password.historyDepth.
model PasswordHistory {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  hash      String
  createdAt DateTime @default(now()) @map("created_at")

  // ── Relationships ──────────────────────────────────────────────────────
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ── Indexes ────────────────────────────────────────────────────────────
  @@index([userId, createdAt], name: "idx_password_history_user")
  @@map("password_history")
}
