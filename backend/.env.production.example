# ─────────────────────────────────────────────────────────────────────────────
# PlateMate — Backend Production Environment Configuration Template
# ─────────────────────────────────────────────────────────────────────────────
# IMPORTANT: Copy this file to .env or set these variables in your deployment
# platform environment settings (Render, Railway, Fly.io, Vercel, Docker).
# DO NOT COMMIT REAL PRODUCTION SECRETS TO VERSION CONTROL!
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. Server Configuration ───────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── 2. Database (PostgreSQL Connection String) ───────────────────────────────
# Must be a valid PostgreSQL connection URL with SSL enabled if required by host
# Example: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/platemate?sslmode=require"

# ── 3. JWT Security Tokens (MUST BE UNIQUE & AT LEAST 32 CHARS) ──────────────
# Generate secure random keys using: openssl rand -base64 32
JWT_ACCESS_SECRET=replace_with_a_secure_random_base64_string_min_32_chars
JWT_REFRESH_SECRET=replace_with_another_secure_random_base64_string_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── 4. Redis Cache & Session Store (Optional / Recommended) ────────────────
# Supported: Local Redis, Upstash Redis, Render Redis, AWS ElastiCache
REDIS_URL=redis://default:password@host:6379
REDIS_TTL_DEFAULT=3600
REDIS_PREFIX=platemate:
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=100

# ── 5. Cloudinary Media Storage (MANDATORY IN PRODUCTION) ───────────────────
# Sign up at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── 6. Razorpay Payment Gateway (MANDATORY IN PRODUCTION) ────────────────────
# Obtain test or live keys from https://dashboard.razorpay.com
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ── 7. Email Service (Resend) ─────────────────────────────────────────────────
# Obtain API key from https://resend.com
RESEND_API_KEY=re_your_resend_api_key
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=PlateMate

# ── 8. CORS & Client Security ────────────────────────────────────────────────
# CLIENT_URL: Main frontend application URL
CLIENT_URL=https://platemate.vercel.app
# ALLOWED_ORIGINS: Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=https://platemate.vercel.app,https://www.yourdomain.com

# ── 9. Google OAuth 2.0 (Optional) ───────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://platemate-api.onrender.com/api/v1/auth/google/callback

# ── 10. Security & Password Hashing ──────────────────────────────────────────
BCRYPT_ROUNDS=12
EMAIL_VERIFY_EXPIRES=24h
PASSWORD_RESET_EXPIRES=1h
