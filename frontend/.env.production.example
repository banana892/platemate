# ─────────────────────────────────────────────────────────────────────────────
# PlateMate — Frontend Production Environment Configuration Template
# ─────────────────────────────────────────────────────────────────────────────
# Set these environment variables in your frontend host build pipeline (Vercel,
# Render Static Site, Netlify, Docker build args).
# Note: Vite embeds variables starting with VITE_ into the static JS bundle at build time.
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. API Base URL ───────────────────────────────────────────────────────────
# Point to your live deployed Express backend API URL
VITE_API_BASE_URL=https://platemate-api.onrender.com/api/v1

# ── 2. WebSocket URL (Optional) ───────────────────────────────────────────────
# If omitted, socket.service.js automatically derives the origin from VITE_API_BASE_URL
VITE_SOCKET_URL=https://platemate-api.onrender.com

# ── 3. Google Maps JavaScript API Key ─────────────────────────────────────────
# Enable Maps JavaScript API and Places API in Google Cloud Console
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ── 4. Razorpay Key ID (Client Side) ──────────────────────────────────────────
# Public Razorpay Key ID for checkout popup initialization
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id
